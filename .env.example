# Runtime only: use Neon pooled host (normally contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/so_turnero?sslmode=require"

# Prisma CLI and migrations only: use the direct Neon host, never runtime code.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/so_turnero?sslmode=require"

# Test-only: set by Jest to an ephemeral Neon schema. Never set this in deployed runtime.
PRISMA_SCHEMA="test_example"
