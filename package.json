{
  "name": "so-turnero",
  "version": "0.1.0",
  "private": true,
  "description": "API-first backend for the SO Turnero academic MVP",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,api,scripts,test}/**/*.ts\"",
    "format": "prettier --write \"{src,api,scripts}/**/*.ts\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"{src,api,scripts}/**/*.ts\" \"*.{json,mjs}\"",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "smoke:di": "cross-env DATABASE_URL=postgresql://runtime:runtime@ep-runtime-pooler.us-east-2.aws.neon.tech/so_turnero?sslmode=require tsx scripts/di-smoke.ts",
    "smoke:health": "cross-env DATABASE_URL=postgresql://runtime:runtime@ep-runtime-pooler.us-east-2.aws.neon.tech/so_turnero?sslmode=require tsx scripts/health-smoke.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration",
    "test:e2e": "jest --runInBand --selectProjects e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "express": "^5.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.0.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  }
}
